	(text "PWM Channel Fiber Transmitters\n\n3-Phases of HRTIM-configurable PWM outputs are \navailable. Each phase's fiber optic transmitter\nset are driven an IX4340NTR gate driver with \nan enable tied to PWM_Enable. (see section for\nexplaination of logic)\n\nAs long as PWM_Enable is not pulled to ground\nan input V_INx > V_thresh will allow the Versatile\nLink TX fiber transmitters to be driven. This \nhappens when both Phase_S and Phase_SN are being \noutput, as computed by the inverter and AND logic\ngates.\n\n(PWM Alt Enable available to repurpose PWM outputs\nin other applications)"
		(exclude_from_sim no)
		(at -566.42 730.25 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "d06d9cdc-5e97-4bf2-bc51-96372469c559")
	)
	(text "AnalogIn_06"
		(exclude_from_sim no)
		(at 20.32 754.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d11159cd-519c-47b1-805e-5dbf5b620a9c")
	)
	(text "Gate Driver Status Receivers\n\nThe Gate Driver Status fiber\nsignals are received by 12 Versatile\nLink RX fiber receivers.\n\nLogic of this device is configured to\nallow selection between Normally\nHIGH GDS and Normally LOW GDS to allow\ncontrol of both the old and new HVPS."
		(exclude_from_sim no)
		(at -132.08 759.46 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "d9b7ae65-ec39-4dd3-8bee-55bd2ec09316")
	)
	(text "USART2_RX"
		(exclude_from_sim no)
		(at 637.54 118.364 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "db584ccd-c531-49bc-841b-e1ef68f624eb")
	)
	(text "PWM Fiber Trigger"
		(exclude_from_sim no)
		(at 547.878 286.258 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dcb2cc63-eb75-4ab3-a67e-ea5e640f1904")
	)
