# macOS
.DS_Store
# Python
__pycache__/
# KiCad: backups, autosaves, caches and per-user view state are not source
**/*-backups/
**/_autosave-*
**/fp-info-cache
**/*.kicad_prl
# the fabrication toolkit's generated backup zips
**/production/backups/
# large archives of third-party documents (GitHub refuses files over 100 MB); keep them elsewhere
hardware/*.zip
host/operator_ui/controllers.json
host/operator_ui/controllers.json.tmp
host/operator_ui/shots/
# a hub site's own settings (allowed client addresses, expected serial): host/config/<name>.local.yaml, never committed
host/config/*.local.yaml
# the Eclipse/CubeIDE workspace folder and KiCad's lock files
.metadata/
**/~*.lck
# LaTeX build intermediates (the .tex and the compiled .pdf are kept)
docs/sop/*.aux
docs/sop/*.log
docs/sop/*.out
docs/sop/*.tdo
docs/sop/*.toc
