# One instance per controller: systemctl enable --now wham-hub@<name> reads <install dir>/host/config/<name>.yaml.
# BEFORE enabling, edit for the server:
#   User              an account that exists on the server (this unit does not create one)
#   WorkingDirectory, ExecStart   the path this repo is installed at, and the python3 to use
#   log_dir (in the yaml)         outside the install tree, e.g. /var/lib/wham/logs; StateDirectory below creates
#                                 /var/lib/wham owned by User, so no manual mkdir or chown is needed
[Unit]
Description=WHAM controller service (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE-ME
StateDirectory=wham
WorkingDirectory=/opt/WHAM-CONTROLLERS/host
ExecStart=/usr/bin/python3 /opt/WHAM-CONTROLLERS/host/wham_hub.py --config /opt/WHAM-CONTROLLERS/host/config/%i.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
